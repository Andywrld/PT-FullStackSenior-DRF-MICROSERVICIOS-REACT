# Optional: copy to ".env". Every variable has a default in docker-compose.yml.

# --- Gateway ---
# Host port the gateway (nginx) publishes. This is the ONLY port exposed to the host.
GATEWAY_PORT=8080

# --- Django (products service) ---
# Insecure default for local/dev use only. Set a real secret in any shared environment.
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-me
DJANGO_DEBUG=0
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,auth
PRODUCTS_ALLOWED_HOSTS=localhost,127.0.0.1,products
CART_ALLOWED_HOSTS=localhost,127.0.0.1,cart
ORDERS_ALLOWED_HOSTS=localhost,127.0.0.1,orders

# --- Auth (users, roles, JWT issuing) ---
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=auth
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Bootstrap super admin created by auth-migrate. CHANGE outside local development.
SUPERADMIN_EMAIL=superadmin@marketplace.local
SUPERADMIN_PASSWORD=SuperAdmin123!
GUNICORN_WORKERS=3

# --- Products database (dedicated Postgres instance, database-per-service) ---
PRODUCTS_POSTGRES_DB=products
PRODUCTS_POSTGRES_USER=products
PRODUCTS_POSTGRES_PASSWORD=products
PRODUCTS_POSTGRES_HOST=products-db
PRODUCTS_POSTGRES_PORT=5432

# --- Catalog cache (Redis, reachable only by the products service) ---
CATALOG_CACHE_TTL_SECONDS=300

# --- Cart database (dedicated Postgres instance, database-per-service) ---
CART_POSTGRES_DB=cart
CART_POSTGRES_USER=cart
CART_POSTGRES_PASSWORD=cart

# --- Orders database (dedicated Postgres instance, database-per-service) ---
ORDERS_POSTGRES_DB=orders
ORDERS_POSTGRES_USER=orders
ORDERS_POSTGRES_PASSWORD=orders

# --- Object storage (MinIO, S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev
# Web console, bound to 127.0.0.1 only.
MINIO_CONSOLE_PORT=9001
S3_BUCKET=product-images
# Least-privilege credentials the products service uses (created by minio-init).
PRODUCTS_S3_ACCESS_KEY=products-service
PRODUCTS_S3_SECRET_KEY=products-service-secret-dev
# Public base for image URLs (served by the gateway under /media/).
MEDIA_PUBLIC_DOMAIN=localhost:8080/media/product-images
MEDIA_URL_PROTOCOL=http:
MAX_IMAGE_UPLOAD_MB=5
MAX_IMAGES_PER_PRODUCT=8
